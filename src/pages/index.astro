---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
---
<BaseLayout
  title="Vaultix — Real-time Data Infrastructure for AI Teams"
  description="Real-time data infrastructure for the next generation of AI teams. Join 2,000+ AI teams already shipping faster with Vaultix."
>
  <!-- Full-screen nav overlay -->
  <MenuOverlay />

  <!-- Site header -->
  <header class="site-header">
    <div class="site-header__inner">
      <Navbar />
    </div>
  </header>

  <!-- Main content -->
  <main id="main-content">
    <Hero />
    <CTA />
  </main>

  <Footer />
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const openBtn      = document.getElementById('menu-open-btn')!;
  const closeBtn     = document.getElementById('menu-close-btn')!;
  const overlay      = document.getElementById('menu-overlay')!;
  const items        = overlay.querySelectorAll<HTMLElement>('.menu-overlay__item');
  const menuFooter   = overlay.querySelector<HTMLElement>('.menu-overlay__footer')!;
  const overlayLinks = overlay.querySelectorAll<HTMLAnchorElement>('.menu-overlay__link');
  const body         = document.body;

  let isOpen   = false;
  let timeline: gsap.core.Timeline | null = null;

  // Splits element text into inline-block word spans for per-word animation
  function splitIntoWords(el: HTMLElement): HTMLElement[] {
    const text = el.textContent?.trim() ?? '';
    el.innerHTML = text
      .split(/\s+/)
      .map(w => `<span class="gsap-word" style="display:inline-block">${w}</span>`)
      .join(' ');
    return Array.from(el.querySelectorAll<HTMLElement>('.gsap-word'));
  }

  const mm = gsap.matchMedia();

  mm.add(
    {
      motion:        '(prefers-reduced-motion: no-preference)',
      reducedMotion: '(prefers-reduced-motion: reduce)',
    },
    (ctx) => {
      const { reducedMotion } = ctx.conditions as { motion: boolean; reducedMotion: boolean };

      // ── Menu: initial hidden state ────────────────
      gsap.set(overlay,    { scaleY: 0, transformOrigin: 'top center', visibility: 'hidden' });
      gsap.set(items,      { y: 60, autoAlpha: 0 });
      gsap.set(menuFooter, { autoAlpha: 0 });

      // ── Page entrance animations ─────────────────
      if (!reducedMotion) {
        // Hero elements
        const siteHeader = document.querySelector<HTMLElement>('.site-header');
        const heroImage  = document.querySelector<HTMLElement>('.hero__image');
        const heroLabel  = document.querySelector<HTMLElement>('.hero__label');
        const heroNameEl = document.querySelector<HTMLElement>('.hero__name');
        const heroBadge  = document.querySelector<HTMLElement>('.hero__badge');
        const heroCta    = document.querySelector<HTMLElement>('.hero__cta');
        const heroDesc   = document.querySelector<HTMLElement>('.hero__description');

        const heroNameWords = heroNameEl ? splitIntoWords(heroNameEl) : [];

        gsap.set(siteHeader, { autoAlpha: 0, y: -12 });
        gsap.set([heroImage, heroLabel, heroBadge, heroCta, heroDesc], { autoAlpha: 0, y: 16 });
        gsap.set(heroNameWords, { autoAlpha: 0, y: 24 });

        // Entrance timeline — soft, sequential, unhurried
        gsap.timeline({ defaults: { ease: 'power3.out' } })
          .to(siteHeader,    { autoAlpha: 1, y: 0, duration: 0.75 })
          .to(heroImage,     { autoAlpha: 1, y: 0, duration: 1.0  }, '-=0.35')
          .to(heroLabel,     { autoAlpha: 1, y: 0, duration: 0.55 }, '-=0.6')
          .to(heroNameWords, { autoAlpha: 1, y: 0, duration: 0.7, stagger: 0.1 }, '-=0.3')
          .to(heroBadge,     { autoAlpha: 1, y: 0, duration: 0.5  }, '-=0.4')
          .to(heroCta,       { autoAlpha: 1, y: 0, duration: 0.5  }, '-=0.35')
          .to(heroDesc,      { autoAlpha: 1, y: 0, duration: 0.65 }, '-=0.3');

        // ── CTA section ───────────────────────────
        const ctaSection = document.querySelector<HTMLElement>('.cta');
        const ctaLabel   = document.querySelector<HTMLElement>('.cta__label');
        const ctaHeading = document.querySelector<HTMLElement>('.cta__heading');
        const ctaSubtext = document.querySelector<HTMLElement>('.cta__subtext');
        const ctaButtons = document.querySelectorAll<HTMLElement>('.cta__buttons a');
        const ctaWidgets = document.querySelectorAll<HTMLElement>('.cta__widget');

        gsap.set([ctaLabel, ctaHeading, ctaSubtext], { autoAlpha: 0, y: 18 });
        gsap.set(ctaButtons, { autoAlpha: 0, y: 12 });
        gsap.set(ctaWidgets, { autoAlpha: 0, y: 22 });

        if (ctaSection) {
          gsap.timeline({
            scrollTrigger: { trigger: ctaSection, start: 'top 82%', once: true },
            defaults: { ease: 'power3.out' },
          })
            .to(ctaLabel,   { autoAlpha: 1, y: 0, duration: 0.55 })
            .to(ctaHeading, { autoAlpha: 1, y: 0, duration: 0.75 }, '-=0.3')
            .to(ctaSubtext, { autoAlpha: 1, y: 0, duration: 0.55 }, '-=0.35')
            .to(ctaButtons, { autoAlpha: 1, y: 0, duration: 0.5, stagger: 0.09 }, '-=0.25');
        }

        // Widget cards animate as they enter the viewport
        gsap.to(ctaWidgets, {
          autoAlpha: 1, y: 0, duration: 0.75, ease: 'power3.out', stagger: 0.1,
          scrollTrigger: { trigger: '.cta__decorative', start: 'top 92%', once: true },
        });

        // ── Footer ────────────────────────────────
        const footerEl     = document.querySelector<HTMLElement>('.footer');
        const footerCols   = document.querySelectorAll<HTMLElement>('.footer__logo-col, .footer__nav-col');
        const footerStay   = document.querySelector<HTMLElement>('.footer__stay-content');
        const footerImgCol = document.querySelector<HTMLElement>('.footer__image-col');

        gsap.set(footerCols, { autoAlpha: 0, y: 18 });
        gsap.set([footerStay, footerImgCol], { autoAlpha: 0, y: 14 });

        if (footerEl) {
          gsap.to(footerCols, {
            autoAlpha: 1, y: 0, duration: 0.65, ease: 'power3.out', stagger: 0.08,
            scrollTrigger: { trigger: footerEl, start: 'top 88%', once: true },
          });
        }

        gsap.to(footerStay, {
          autoAlpha: 1, y: 0, duration: 0.65, ease: 'power3.out',
          scrollTrigger: { trigger: footerStay, start: 'top 90%', once: true },
        });

        gsap.to(footerImgCol, {
          autoAlpha: 1, y: 0, duration: 0.85, ease: 'power3.out',
          scrollTrigger: { trigger: footerImgCol, start: 'top 92%', once: true },
        });
      }

      // ── Open menu ─────────────────────────────────
      function openMenu() {
        if (isOpen) return;
        isOpen = true;

        openBtn.setAttribute('aria-expanded', 'true');
        overlay.setAttribute('aria-hidden', 'false');
        overlayLinks.forEach((l) => l.setAttribute('tabindex', '0'));
        closeBtn.setAttribute('tabindex', '0');
        body.style.overflow = 'hidden';

        if (timeline) timeline.kill();

        if (reducedMotion) {
          gsap.set(overlay,    { scaleY: 1, visibility: 'visible' });
          gsap.set(items,      { y: 0, autoAlpha: 1 });
          gsap.set(menuFooter, { autoAlpha: 1 });
          closeBtn.focus();
          return;
        }

        timeline = gsap.timeline({
          defaults: { ease: 'power3.out' },
          onComplete: () => closeBtn.focus(),
        });

        timeline
          .to(overlay,    { scaleY: 1, visibility: 'visible', duration: 0.9, ease: 'expo.inOut' })
          .to(items,      { y: 0, autoAlpha: 1, duration: 0.75, stagger: 0.07 }, '-=0.45')
          .to(menuFooter, { autoAlpha: 1, duration: 0.4 }, '-=0.3');
      }

      // ── Close menu ────────────────────────────────
      function closeMenu() {
        if (!isOpen) return;
        isOpen = false;

        openBtn.setAttribute('aria-expanded', 'false');
        overlay.setAttribute('aria-hidden', 'true');
        overlayLinks.forEach((l) => l.setAttribute('tabindex', '-1'));
        closeBtn.setAttribute('tabindex', '-1');
        body.style.overflow = '';

        if (timeline) timeline.kill();

        if (reducedMotion) {
          gsap.set(overlay,    { scaleY: 0, visibility: 'hidden' });
          gsap.set(items,      { y: 60, autoAlpha: 0 });
          gsap.set(menuFooter, { autoAlpha: 0 });
          openBtn.focus();
          return;
        }

        timeline = gsap.timeline({
          onComplete: () => {
            gsap.set(overlay, { visibility: 'hidden' });
            openBtn.focus();
          },
        });

        timeline
          .to([items, menuFooter], {
            autoAlpha: 0, y: 30, duration: 0.35, stagger: 0.04, ease: 'power2.in',
          })
          .to(overlay, { scaleY: 0, duration: 0.7, ease: 'expo.inOut' }, '-=0.15');
      }

      // ── Event listeners ───────────────────────────
      openBtn.addEventListener('click',  openMenu);
      closeBtn.addEventListener('click', closeMenu);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen) closeMenu();
      });

      overlayLinks.forEach((link) => {
        link.addEventListener('click', () => {
          if (isOpen) closeMenu();
        });
      });

      return () => {
        if (timeline) timeline.kill();
        body.style.overflow = '';
        ScrollTrigger.getAll().forEach(st => st.kill());
      };
    }
  );
</script>

<style>
  .site-header {
    background: var(--color-bg-dark);
    position: relative;
  }

  .site-header__inner {
    max-width: var(--size-container);
    margin-inline: auto;
    padding: 1.5em 11em;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  @media (max-width: 991px) {
    .site-header__inner {
      padding: 1.5em var(--container-padding);
    }
  }
</style>
