---
const links = [
  { num: "01", label: "Home",     href: "/" },
  { num: "02", label: "About",    href: "#about" },
  { num: "03", label: "Platform", href: "#platform" },
  { num: "04", label: "Pricing",  href: "#pricing" },
  { num: "05", label: "Blog",     href: "#blog" },
  { num: "06", label: "Contact",  href: "#contact" },
];
---

<div
  class="menu-overlay"
  id="menu-overlay"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <!-- Header row — mirrors navbar position -->
  <div class="menu-overlay__header">
    <div class="menu-overlay__header-inner">
      <a href="/" class="menu-overlay__logo" aria-label="Vaultix home" tabindex="-1">
        <img
          src="/assets/images/logo-icon.svg"
          alt=""
          width="26"
          height="19"
          role="presentation"
        />
        <span class="menu-overlay__logo-text">Vaultix</span>
      </a>

      <button
        class="menu-overlay__close"
        id="menu-close-btn"
        aria-label="Close navigation menu"
        tabindex="-1"
      >
        <span class="menu-overlay__close-text">Close</span>
        <svg
          class="menu-overlay__close-icon"
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <line x1="2" y1="2" x2="18" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
          <line x1="18" y1="2" x2="2" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Divider line -->
  <div class="menu-overlay__divider" aria-hidden="true"></div>

  <!-- Nav links -->
  <nav class="menu-overlay__nav" aria-label="Site navigation">
    <ul class="menu-overlay__list">
      {links.map((link) => (
        <li class="menu-overlay__item">
          <a href={link.href} class="menu-overlay__link" tabindex="-1">
            <span class="menu-overlay__num" aria-hidden="true">{link.num}</span>
            <span class="menu-overlay__label">{link.label}</span>
            <svg
              class="menu-overlay__arrow"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Footer strip -->
  <div class="menu-overlay__footer" aria-hidden="true">
    <div class="menu-overlay__footer-inner">
      <p class="menu-overlay__tagline">
        Real-time data infrastructure for the next generation of AI teams.
      </p>
      <p class="menu-overlay__copy">© 2024 Vaultix</p>
    </div>
  </div>
</div>

<style>
  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 500;
    background: var(--color-bg-dark);
    display: flex;
    flex-direction: column;
    visibility: hidden;
    /* GSAP controls scaleY, set origin here */
    transform-origin: top center;
  }

  /* ── Header ────────────────────────────────── */
  .menu-overlay__header {
    flex-shrink: 0;
  }

  .menu-overlay__header-inner {
    max-width: var(--size-container);
    margin-inline: auto;
    padding: 1.5em 11em;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu-overlay__logo {
    display: flex;
    align-items: center;
    gap: 0.75em;
    text-decoration: none;
  }

  .menu-overlay__logo-text {
    font-family: var(--font-body);
    font-size: 0.875em;
    font-weight: 400;
    line-height: 1.286;
    letter-spacing: 1.68px;
    text-transform: uppercase;
    color: var(--color-text-white);
    white-space: nowrap;
  }

  .menu-overlay__close {
    display: flex;
    align-items: center;
    gap: 0.75em;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25em 0;
    color: var(--color-text-white);
  }

  .menu-overlay__close-text {
    font-family: var(--font-body);
    font-size: 0.875em;
    font-weight: 400;
    line-height: 1.286;
    letter-spacing: 1.68px;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .menu-overlay__close-icon {
    width: 1.25em;
    height: 1.25em;
    color: var(--color-text-white);
    flex-shrink: 0;
  }

  /* ── Divider ───────────────────────────────── */
  .menu-overlay__divider {
    width: 100%;
    height: 1px;
    background: var(--color-border);
    flex-shrink: 0;
  }

  /* ── Nav list ──────────────────────────────── */
  .menu-overlay__nav {
    flex: 1;
    display: flex;
    align-items: center;
    max-width: var(--size-container);
    margin-inline: auto;
    padding-inline: 11em;
    width: 100%;
  }

  .menu-overlay__list {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
  }

  .menu-overlay__item {
    border-bottom: 1px solid var(--color-border);
  }

  .menu-overlay__item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .menu-overlay__link {
    display: flex;
    align-items: center;
    gap: 2em;
    padding: 0.625em 0;
    text-decoration: none;
    color: var(--color-text-white);
    position: relative;
    overflow: hidden;
  }

  .menu-overlay__num {
    font-family: var(--font-body);
    font-size: 0.625em;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    flex-shrink: 0;
    width: 2em;
  }

  .menu-overlay__label {
    font-family: var(--font-heading);
    font-size: 4.5em;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 8.64px;
    text-transform: uppercase;
    color: var(--color-text-white);
    flex: 1;
    /* color transition on hover */
    transition: color 0.3s ease;
  }

  .menu-overlay__link:hover .menu-overlay__label {
    color: var(--color-primary);
  }

  .menu-overlay__arrow {
    width: 1.75em;
    height: 1.75em;
    color: var(--color-text-muted);
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-0.5em);
    transition: opacity 0.3s ease, transform 0.3s ease, color 0.3s ease;
  }

  .menu-overlay__link:hover .menu-overlay__arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-primary);
  }

  /* ── Footer strip ──────────────────────────── */
  .menu-overlay__footer {
    flex-shrink: 0;
    border-top: 1px solid var(--color-border);
  }

  .menu-overlay__footer-inner {
    max-width: var(--size-container);
    margin-inline: auto;
    padding: 1.25em 11em;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu-overlay__tagline,
  .menu-overlay__copy {
    font-family: var(--font-body);
    font-size: 0.75em;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.96px;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ── Responsive ────────────────────────────── */
  @media (max-width: 991px) {
    .menu-overlay__header-inner,
    .menu-overlay__nav,
    .menu-overlay__footer-inner {
      padding-inline: var(--container-padding);
    }

    .menu-overlay__label {
      font-size: 3em;
      letter-spacing: 5.76px;
    }
  }

  @media (max-width: 767px) {
    .menu-overlay__label {
      font-size: 2.25em;
      letter-spacing: 3px;
    }

    .menu-overlay__link {
      gap: 1em;
    }

    .menu-overlay__arrow {
      display: none;
    }
  }

  @media (max-width: 479px) {
    .menu-overlay__label {
      font-size: 1.75em;
      letter-spacing: 2px;
    }

    .menu-overlay__footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5em;
    }
  }
</style>
