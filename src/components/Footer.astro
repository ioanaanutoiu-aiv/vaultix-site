---
const navColumns = [
  {
    label: "Features",
    links: [
      { text: "Features", href: "#" },
      { text: "Pricing", href: "#" },
      { text: "Integrations", href: "#" },
      { text: "Changelog", href: "#" },
    ],
  },
  {
    label: "Company",
    links: [
      { text: "About", href: "#" },
      { text: "Blog", href: "#" },
      { text: "Careers", href: "#" },
      { text: "Contact", href: "#" },
    ],
  },
  {
    label: "Legal",
    links: [
      { text: "Privacy", href: "#" },
      { text: "Terms", href: "#" },
      { text: "Licensing", href: "#" },
      { text: "Cookies", href: "#" },
    ],
  },
];
---
<footer class="footer" aria-label="Site footer">
  <div class="footer__inner">

    <!-- Top nav section -->
    <div class="footer__nav-section">
      <!-- Logo column -->
      <div class="footer__logo-col">
        <a href="/" class="footer__logo" aria-label="Vaultix home">
          <img
            src="/assets/images/footer-logo-icon.svg"
            alt=""
            width="26"
            height="21"
            role="presentation"
          />
          <span class="footer__logo-text">Vaultix</span>
        </a>
        <p class="footer__tagline">
          Real-time data infrastructure for the next generation of AI teams.
        </p>
      </div>

      <!-- Navigation columns -->
      {navColumns.map((col) => (
        <div class="footer__nav-col">
          <nav aria-label={col.label}>
            <ul class="footer__nav-list">
              {col.links.map((link) => (
                <li class="footer__nav-item">
                  <a href={link.href} class="footer__nav-link">
                    <span>{link.text}</span>
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                      class="footer__nav-arrow"
                    >
                      <path
                        d="M8 5l8 7-8 7"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="square"
                      />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      ))}
    </div>

    <!-- Bottom stay updated section -->
    <div class="footer__bottom">
      <!-- Stay updated column -->
      <div class="footer__stay-col">
        <div class="footer__stay-content">
          <h2 class="footer__stay-heading">Stay updated</h2>
          <p class="footer__stay-text">
            Subscribe to our newsletter for engineering insights and product updates.
          </p>
          <a href="#contact" class="btn-primary footer__stay-cta">Contact us</a>
        </div>
      </div>

      <!-- Image column with Vaultix watermark -->
      <div class="footer__image-col">
        <div class="footer__image-wrapper">
          <img
            src="/assets/images/footer-main-image.png"
            alt=""
            role="presentation"
            width="846"
            height="398"
            class="footer__bg-image footer__bg-image--1"
            loading="lazy"
          />
          <img
            src="/assets/images/footer-main-image2.png"
            alt=""
            role="presentation"
            width="846"
            height="398"
            class="footer__bg-image footer__bg-image--2"
            loading="lazy"
          />
          <div class="footer__image-overlay" aria-hidden="true"></div>
          <span class="footer__watermark" aria-hidden="true">Vaultix</span>
        </div>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-dark);
    border-top: 1px solid var(--color-border);
    overflow: hidden;
  }

  .footer__inner {
    max-width: var(--size-container);
    margin-inline: auto;
    padding-inline: var(--container-padding);
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
  }

  /* Top nav section */
  .footer__nav-section {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    border-bottom: 1px solid var(--color-border);
  }

  .footer__logo-col,
  .footer__nav-col {
    padding: 1.5em;
    border-right: 1px solid var(--color-border);
  }

  .footer__nav-col:last-child {
    border-right: none;
  }

  .footer__logo {
    display: flex;
    align-items: center;
    gap: 0.75em;
    text-decoration: none;
    margin-bottom: 1.5em;
  }

  .footer__logo-text {
    font-family: var(--font-body);
    font-size: 0.875em;
    font-weight: 400;
    line-height: 1.286;
    letter-spacing: 1.68px;
    text-transform: uppercase;
    color: var(--color-text-white);
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-size: 0.875em;
    font-weight: 400;
    line-height: 1.286;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .footer__nav-list {
    display: flex;
    flex-direction: column;
  }

  .footer__nav-item {
    border-bottom: 1px solid var(--color-border);
  }

  .footer__nav-item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .footer__nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25em 1.5em;
    font-family: var(--font-body);
    font-size: 0.875em;
    font-weight: 400;
    line-height: 1.286;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer__nav-arrow {
    width: 1.125em;
    height: 1.125em;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  /* Bottom section */
  .footer__bottom {
    display: grid;
    grid-template-columns: 17.625em 1fr; /* 282px left col */
    border-top: 0; /* top border is footer__nav-section bottom */
  }

  .footer__stay-col {
    padding: 1.5em;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
  }

  .footer__stay-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5em;
    height: 100%;
    min-height: 21.875em; /* 350px */
  }

  .footer__stay-heading {
    font-family: var(--font-heading);
    font-size: 2em; /* 32px */
    font-weight: 400;
    line-height: 1;
    letter-spacing: 3.84px;
    text-transform: uppercase;
    color: var(--color-text-white);
  }

  .footer__stay-text {
    font-family: var(--font-body);
    font-size: 0.875em;
    font-weight: 400;
    line-height: 1.286;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .footer__stay-cta {
    width: fit-content;
  }

  /* Image column */
  .footer__image-col {
    border-bottom: 1px solid var(--color-border);
    position: relative;
    min-height: 24.875em; /* ~398px */
    overflow: hidden;
  }

  .footer__image-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .footer__bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .footer__bg-image--2 {
    mix-blend-mode: screen;
    opacity: 0.7;
  }

  .footer__image-overlay {
    position: absolute;
    inset: 0;
    background: #b5d2ff;
    opacity: 0.15;
  }

  .footer__watermark {
    position: absolute;
    bottom: 1em;
    left: 0.8125em;
    font-family: var(--font-heading);
    font-size: 11.9em; /* ~190px at 16px base */
    font-weight: 900;
    line-height: 1.285;
    letter-spacing: -0.02em; /* decorative giant text — uses em */
    text-transform: uppercase;
    color: #010101;
    white-space: nowrap;
    user-select: none;
  }

  /* Responsive */
  @media (max-width: 991px) {
    .footer__nav-section {
      grid-template-columns: 1fr 1fr;
    }

    .footer__logo-col {
      grid-column: 1 / -1;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      display: flex;
      gap: 1.5em;
      align-items: flex-start;
    }

    .footer__logo {
      margin-bottom: 0;
      flex-shrink: 0;
    }

    .footer__nav-col:nth-child(even) {
      border-right: none;
    }

    .footer__bottom {
      grid-template-columns: 1fr;
    }

    .footer__stay-col {
      border-right: none;
    }

    .footer__watermark {
      font-size: 7em;
    }
  }

  @media (max-width: 767px) {
    .footer__nav-section {
      grid-template-columns: 1fr;
    }

    .footer__logo-col {
      flex-direction: column;
    }

    .footer__nav-col {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .footer__image-col {
      min-height: 15em;
    }

    .footer__watermark {
      font-size: 4em;
    }
  }
</style>
