---
---
<section class="cta" aria-labelledby="cta-heading">
  <div class="cta__inner">
    <div class="cta__header">
      <p class="cta__label"> [ How it work ]</p>
      <h2 id="cta-heading" class="cta__heading">
        Ready to build the future<br />
        of your data stack?
      </h2>
      <p class="cta__subtext">Join 2,000+ AI teams already shipping faster with Vaultix.</p>
    </div>

    <div class="cta__buttons">
      <a href="#" class="btn-primary">Start Building Free</a>
      <a href="#" class="btn-secondary">Book a Demo</a>
    </div>
  </div>

  <!-- Decorative polygon + widget area -->
  <div class="cta__decorative" aria-hidden="true">
    <!-- Polygon outlines -->
    <img src="/assets/images/cta-polygon1.svg" alt="" role="presentation" class="cta__polygon cta__polygon--1" />
    <img src="/assets/images/cta-polygon2.svg" alt="" role="presentation" class="cta__polygon cta__polygon--2" />
    <img src="/assets/images/cta-polygon3.svg" alt="" role="presentation" class="cta__polygon cta__polygon--3" />
    <img src="/assets/images/cta-polygon4.svg" alt="" role="presentation" class="cta__polygon cta__polygon--4" />

    <!-- Widget cards -->
    <div class="cta__widgets">
      <!-- Left card: Live System -->
      <div class="cta__widget cta__widget--live">
        <p class="cta__widget-label">Live System</p>
        <p class="cta__widget-stat">3.2TB</p>
        <div class="cta__widget-bars">
          <div class="cta__wbar cta__wbar--accent"></div>
          <div class="cta__wbar"></div>
          <div class="cta__wbar cta__wbar--accent"></div>
          <div class="cta__wbar cta__wbar--tall"></div>
          <div class="cta__wbar"></div>
          <div class="cta__wbar cta__wbar--accent cta__wbar--tall"></div>
          <div class="cta__wbar cta__wbar--short"></div>
          <div class="cta__wbar cta__wbar--accent"></div>
        </div>
      </div>

      <!-- Center card: Ship Smarter -->
      <div class="cta__widget cta__widget--center">
        <div class="cta__widget-img-wrap">
          <img
            src="/assets/images/cta-widget-center.png"
            alt=""
            role="presentation"
            class="cta__widget-img"
            loading="lazy"
          />
        </div>
        <div class="cta__widget-body">
          <p class="cta__widget-heading">Ship Smarter<br />Scale Faster</p>
          <ul class="cta__widget-tags">
            <li class="cta__widget-tag"><span class="cta__tag-dot"></span>Built for Trust</li>
            <li class="cta__widget-tag"><span class="cta__tag-dot"></span>Always Secure</li>
            <li class="cta__widget-tag"><span class="cta__tag-dot"></span>Encrypted</li>
            <li class="cta__widget-tag"><span class="cta__tag-dot"></span>Always Secure</li>
          </ul>
        </div>
      </div>

      <!-- Right card: Reporting Insights -->
      <div class="cta__widget cta__widget--chart">
        <p class="cta__chart-title">Reporting Insights</p>
        <div class="cta__chart-meta">
          <span class="cta__chart-month">January</span>
          <span class="cta__chart-value">70%</span>
        </div>
        <div class="cta__chart-bars">
          <div class="cta__col">
            <div class="cta__bar cta__bar--dim"></div>
            <div class="cta__bar"></div>
            <div class="cta__bar cta__bar--dim"></div>
            <div class="cta__bar cta__bar--dim"></div>
          </div>
          <div class="cta__col">
            <div class="cta__bar cta__bar--dim"></div>
            <div class="cta__bar cta__bar--dim"></div>
            <div class="cta__bar"></div>
            <div class="cta__bar cta__bar--dim"></div>
          </div>
          <div class="cta__col">
            <div class="cta__bar cta__bar--dim"></div>
            <div class="cta__bar"></div>
            <div class="cta__bar cta__bar--dim"></div>
            <div class="cta__bar cta__bar--dim"></div>
          </div>
          <div class="cta__col">
            <div class="cta__bar cta__bar--dim"></div>
            <div class="cta__bar cta__bar--dim"></div>
            <div class="cta__bar"></div>
            <div class="cta__bar cta__bar--dim"></div>
          </div>
          <div class="cta__col">
            <div class="cta__bar cta__bar--dim"></div>
            <div class="cta__bar"></div>
            <div class="cta__bar"></div>
            <div class="cta__bar cta__bar--dim"></div>
          </div>
          <div class="cta__col">
            <div class="cta__bar"></div>
            <div class="cta__bar cta__bar--dim"></div>
            <div class="cta__bar cta__bar--dim"></div>
            <div class="cta__bar cta__bar--dim"></div>
          </div>
          <div class="cta__col">
            <div class="cta__bar cta__bar--dim"></div>
            <div class="cta__bar cta__bar--dim"></div>
            <div class="cta__bar"></div>
            <div class="cta__bar cta__bar--dim"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--color-bg-gray);
    padding-block: 3.25em;
    overflow: hidden;
    position: relative;
  }

  .cta__inner {
    max-width: var(--size-container);
    margin-inline: auto;
    padding-inline: var(--container-padding);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4.75em;
    position: relative;
    z-index: 1;
  }

  .cta__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75em;
    text-align: center;
  }

  .cta__label {
    font-family: var(--font-body);
    font-size: 0.875em;
    font-weight: 400;
    line-height: 1.286;
    letter-spacing: 1.68px;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .cta__heading {
    font-family: var(--font-heading);
    font-size: 3em;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 5.76px;
    text-transform: uppercase;
    color: var(--color-text-white);
  }

  .cta__subtext {
    font-family: var(--font-body);
    font-size: 0.875em;
    font-weight: 400;
    line-height: 1.286;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-text-muted);
    max-width: 32.3125em;
  }

  .cta__buttons {
    display: flex;
    align-items: center;
    gap: 0.75em;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Decorative area */
  .cta__decorative {
    position: relative;
    width: 100%;
    height: 32em;
  }

  .cta__polygon {
    position: absolute;
    pointer-events: none;
  }

  /* Polygon positions mirror Figma: centered in the 1336px content area */
  .cta__polygon--1 {
    left: 13.66%;
    top: 0;
    width: 65.6%;
    height: auto;
  }

  .cta__polygon--2 {
    left: 14%;
    top: 0.3em;
    width: 64.1%;
    height: auto;
    opacity: 0.7;
  }

  .cta__polygon--3 {
    left: 13.66%;
    top: 0;
    width: 65.6%;
    height: auto;
    opacity: 0.4;
  }

  .cta__polygon--4 {
    left: -2%;
    top: -8em;
    width: 92.8%;
    height: auto;
    transform: rotate(46.09deg) skewX(2.19deg);
    opacity: 0.5;
    transform-origin: center center;
  }

  /* Widget cards row */
  .cta__widgets {
    position: absolute;
    bottom: 0;
    left: var(--container-padding);
    right: var(--container-padding);
    display: flex;
    align-items: flex-end;
    gap: 0;
  }

  .cta__widget {
    background: #010101;
    border: 1px solid var(--color-border);
    padding: 0.6875em;
    flex-shrink: 0;
  }

  /* Live System card */
  .cta__widget--live {
    width: 16.44em; /* ~263px */
    display: flex;
    flex-direction: column;
    gap: 0.75em;
    margin-right: 0.75em;
  }

  .cta__widget-label {
    font-family: var(--font-body);
    font-size: 0.5625em;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 1.09px;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cta__widget-stat {
    font-family: var(--font-heading);
    font-size: 2.5em;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-text-white);
  }

  .cta__widget-bars {
    display: flex;
    align-items: flex-end;
    gap: 0.25em;
    height: 3.5em;
    width: 100%;
  }

  .cta__wbar {
    flex: 1;
    height: 60%;
    background: var(--color-border);
  }

  .cta__wbar--accent {
    background: #b5d2ff;
    opacity: 0.6;
  }

  .cta__wbar--tall {
    height: 90%;
  }

  .cta__wbar--short {
    height: 35%;
  }

  /* Ship Smarter card */
  .cta__widget--center {
    width: 20em; /* ~320px */
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    margin-right: auto;
  }

  .cta__widget-img-wrap {
    width: 100%;
    height: 10em;
    overflow: hidden;
  }

  .cta__widget-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: grayscale(1);
  }

  .cta__widget-body {
    padding: 0.75em;
    display: flex;
    flex-direction: column;
    gap: 0.75em;
  }

  .cta__widget-heading {
    font-family: var(--font-heading);
    font-size: 1.25em;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: var(--color-text-white);
  }

  .cta__widget-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375em;
  }

  .cta__widget-tag {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-body);
    font-size: 0.625em;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 0.3em 0.6em;
    width: fit-content;
  }

  .cta__tag-dot {
    width: 0.25em;
    height: 0.25em;
    background: var(--color-primary);
    flex-shrink: 0;
  }

  /* Reporting Insights chart card */
  .cta__widget--chart {
    width: 21em;
    display: flex;
    flex-direction: column;
    gap: 0.875em;
  }

  .cta__chart-title {
    font-family: var(--font-body);
    font-size: 0.75em;
    font-weight: 400;
    line-height: 1.286;
    letter-spacing: 1.52px;
    text-transform: uppercase;
    color: var(--color-text-white);
    text-align: center;
  }

  .cta__chart-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-body);
    font-size: 0.5625em;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 1.09px;
    text-transform: uppercase;
  }

  .cta__chart-month {
    color: var(--color-text-muted);
  }

  .cta__chart-value {
    color: #b5d2ff;
  }

  .cta__chart-bars {
    display: flex;
    align-items: flex-end;
    gap: 0.375em;
    height: 5.5em;
    width: 100%;
  }

  .cta__col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25em;
  }

  .cta__bar {
    height: 0.6875em;
    background: #b5d2ff;
    box-shadow: 0 0 2.723px rgba(95,92,255,0.78), 0 0.908px 5.446px rgba(95,92,255,0.67);
  }

  .cta__bar--dim {
    opacity: 0.4;
  }

  /* Responsive */
  @media (max-width: 991px) {
    .cta__heading {
      font-size: 2.25em;
    }

    .cta__decorative {
      height: 28em;
    }

    .cta__widget--center {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .cta__heading {
      font-size: 1.75em;
      letter-spacing: 3px;
    }

    .cta__buttons {
      flex-direction: column;
      width: 100%;
    }

    .cta__buttons .btn-primary,
    .cta__buttons .btn-secondary {
      width: 100%;
      text-align: center;
      justify-content: center;
    }

    .cta__decorative {
      height: 20em;
    }

    .cta__widget--live {
      display: none;
    }

    .cta__widget--chart {
      width: 100%;
    }
  }
</style>
