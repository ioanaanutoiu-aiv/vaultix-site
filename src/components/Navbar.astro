---
---
<nav class="navbar" aria-label="Main navigation">
  <a href="/" class="navbar__logo" aria-label="Vaultix home">
    <img
      src="/assets/images/logo-icon.svg"
      alt=""
      width="26"
      height="19"
      class="navbar__logo-icon"
      role="presentation"
    />
    <span class="navbar__logo-text">Vaultix</span>
  </a>

  <button
    class="navbar__menu-btn"
    id="menu-open-btn"
    aria-expanded="false"
    aria-controls="menu-overlay"
    aria-label="Open navigation menu"
  >
    <span class="navbar__menu-label">Menu</span>
    <span class="navbar__menu-icon" aria-hidden="true">
      <span class="navbar__bar"></span>
      <span class="navbar__bar"></span>
      <span class="navbar__bar"></span>
    </span>
  </button>
</nav>

<style>
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .navbar__logo {
    display: flex;
    align-items: center;
    gap: 0.75em;
    text-decoration: none;
    flex-shrink: 0;
  }

  .navbar__logo-icon {
    width: 1.625em;
    height: auto;
    flex-shrink: 0;
  }

  .navbar__logo-text {
    font-family: var(--font-body);
    font-size: 0.875em;
    font-weight: 400;
    line-height: 1.286;
    letter-spacing: 1.68px;
    text-transform: uppercase;
    color: var(--color-text-white);
    white-space: nowrap;
  }

  /* MENU button */
  .navbar__menu-btn {
    display: flex;
    align-items: center;
    gap: 0.875em;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25em 0;
    color: var(--color-text-white);
  }

  .navbar__menu-label {
    font-family: var(--font-body);
    font-size: 0.875em;
    font-weight: 400;
    line-height: 1.286;
    letter-spacing: 1.68px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .navbar__menu-icon {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3125em;
    width: 1.5em;
    flex-shrink: 0;
  }

  .navbar__bar {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-text-white);
  }

  @media (max-width: 991px) {
    .navbar__menu-label {
      display: none;
    }
  }
</style>
